{
  "name": "roadbook",
  "version": "0.2.0",
  "private": true,
  "description": "RoadBook（路书）DSH 主插件：一个组合包装齐流程技能、自动加载与图纸工作台；每个子行在 DSH 插件面板里可独立开关。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./bundle": "./lib/bundle.js",
    "./autoload": "./plugin/roadbook-autoload/index.js",
    "./atlas": "./plugin/roadbook-atlas/lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "plugin",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-better-sidebar": "^0.24.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\" && node --test \"plugin/roadbook-autoload/test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
