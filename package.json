{
  "name": "roadbook",
  "version": "0.7.2",
  "private": true,
  "description": "RoadBook（路书）DSH 主插件：一个组合包装齐流程技能、自动加载、图纸工作台与自进化信号表；每个子行在 DSH 插件面板里可独立开关。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aparencia/RoadBook.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./autoload": "./plugin/roadbook-autoload/index.js",
    "./atlas": "./plugin/roadbook-atlas/lib/index.js",
    "./team": "./plugin/roadbook-team/index.js",
    "./evolve": "./plugin/roadbook-evolve/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "plugin",
    "playbook",
    "playbook_EN",
    "template",
    "rules",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "dsh-better-sidebar": "^0.24.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\" && node --test \"plugin/roadbook-autoload/test/*.test.mjs\" && node --test \"plugin/roadbook-evolve/test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
